body {
    font-family: Arial, sans-serif;
    text-align: center;
    background-color: #e6fff2;
}

h1 {
    color: #00695c;
}

button {
    background-color: #26a69a;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background-color: #004d40;
}

#question {
    font-size: 20px;
    margin: 20px;
}

#result {
    font-size: 18px;
    font-weight: bold;
    margin-top: 20px;
}
